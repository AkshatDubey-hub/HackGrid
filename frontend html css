    <!-- ================= JAVASCRIPT LOGIC ================= -->
    <script type="module">
        import { Renderer, Program, Mesh, Triangle, Color } from 'https://esm.sh/ogl@1.0.10';

        const PAD = 20;

        const VERT = `#version 300 es
        in vec2 position;
        void main() {
            gl_Position = vec4(position, 0.0, 1.0);
        }
        `;

        const FRAG = `#version 300 es
        precision highp float;

        uniform vec2 uCenter;
        uniform vec2 uHalfSize;
        uniform float uRadius;
        uniform float uAngle;
        uniform float uPx;
        uniform vec3 uLineColor;
        uniform vec3 uBaseColor;
        uniform float uIntensity;
        uniform float uShineSize;
        uniform float uShineFade;
        uniform float uThickness;
        uniform float uBaseWidth;

        out vec4 fragColor;

        float sdRoundedRect(vec2 p, vec2 b, float r) {
            vec2 q = abs(p) - b + r;
            return length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - r;
        }

        float shapeSDF(vec2 p) { return sdRoundedRect(p, uHalfSize, uRadius); }

        float gaussianLine(float d, float sigma) {
            float x = d / (sigma + 1e-6);
            float k = mix(1.0, 1.6, smoothstep(0.0, 1.5, x));
            return exp(-k * x * x);
        }

        void main() {
            vec2 p = gl_FragCoord.xy - uCenter;
            float d = shapeSDF(p);
            vec2 L = vec2(cos(uAngle), sin(uAngle));

            float base = (1.0 - smoothstep(0.0, uBaseWidth, abs(d))) * 0.45;

            vec2 nEll = normalize(p / (uHalfSize * uHalfSize) + 1e-6);
            float phi = acos(clamp(abs(dot(nEll, L)), 0.0, 1.0));
            float rim = 1.0 - smoothstep(uShineSize - uShineFade, uShineSize + uShineFade + 1e-4, phi);
            float line = gaussianLine(d, uThickness);
            float edgeClamp = 1.0 - smoothstep(0.5 * uPx, 3.0 * uPx, abs(d));
            float hi = line * rim * edgeClamp * uIntensity;

            vec3 col = uBaseColor * base + uLineColor * hi;
            float a = clamp(base + hi, 0.0, 1.0);
            fragColor = vec4(col, a);
        }
        `;

        class SpecularButton {
            constructor(btn, props) {
                this.btn = btn;
                this.fx = btn.querySelector('.specular-button__fx');
                this.props = props;

                const dpr = window.devicePixelRatio || 1;
                this.renderer = new Renderer({ alpha: true, premultipliedAlpha: true, antialias: true, dpr });
                const gl = this.renderer.gl;
                gl.clearColor(0, 0, 0, 0);
                gl.enable(gl.BLEND);
                gl.blendFunc(gl.ONE, gl.ONE_MINUS_SRC_ALPHA);

                const geometry = new Triangle(gl);
                if (geometry.attributes.uv) delete geometry.attributes.uv;

                const lineC = new Color(props.lineColor);
                const baseC = new Color(props.baseColor);

                this.program = new Program(gl, {
                    vertex: VERT,
                    fragment: FRAG,
                    uniforms: {
                        uCenter: { value: [0, 0] },
                        uHalfSize: { value: [1, 1] },
                        uRadius: { value: 0 },
                        uAngle: { value: 2.4 },
                        uPx: { value: dpr },
                        uLineColor: { value: [lineC.r, lineC.g, lineC.b] },
                        uBaseColor: { value: [baseC.r, baseC.g, baseC.b] },
                        uIntensity: { value: 0 },
                        uShineSize: { value: (props.shineSize * Math.PI) / 180 },
                        uShineFade: { value: (props.shineFade * Math.PI) / 180 },
                        uThickness: { value: props.thickness * dpr },
                        uBaseWidth: { value: dpr }
                    }
                });

                this.mesh = new Mesh(gl, { geometry, program: this.program });
                this.fx.appendChild(gl.canvas);

                this.size = { w: 1, h: 1 };
                this.resize = () => {
                    const rect = this.btn.getBoundingClientRect();
                    const w = rect.width;
                    const h = rect.height;
                    this.size.w = w;
                    this.size.h = h;
                    this.renderer.setSize(w + PAD * 2, h + PAD * 2);
                    this.program.uniforms.uCenter.value = [(PAD + w / 2) * dpr, (PAD + h / 2) * dpr];
                    this.program.uniforms.uHalfSize.value = [(w / 2) * dpr, (h / 2) * dpr];
                    this.program.uniforms.uRadius.value = Math.min(props.radius, Math.min(w, h) / 2) * dpr;
                };

                this.ro = new ResizeObserver(this.resize);
                this.ro.observe(this.btn);
                this.resize();

                this.pointerAngle = null;
                this.proximityT = 0;
                this.onPointerMove = (e) => {
                    const rect = this.btn.getBoundingClientRect();
                    const cx = rect.left + rect.width / 2;
                    const cy = rect.top + rect.height / 2;
                    const dx = Math.max(rect.left - e.clientX, 0, e.clientX - rect.right);
                    const dy = Math.max(rect.top - e.clientY, 0, e.clientY - rect.bottom);
                    const dist = Math.hypot(dx, dy);

                    if (dist === 0) {
                        const nx = (e.clientX - cx) / (rect.width / 2);
                        const ny = (cy - e.clientY) / (rect.height / 2);
                        this.pointerAngle = Math.atan2(2 / rect.height, -2 / rect.width) + nx * 0.3 + ny * 0.15;
                    } else {
                        this.pointerAngle = Math.atan2(cy - e.clientY, e.clientX - cx);
                    }
                    const t = Math.max(0, 1 - dist / Math.max(props.proximity, 1));
                    this.proximityT = t * t * (3 - 2 * t);
                };
                window.addEventListener('pointermove', this.onPointerMove);

                this.angle = 2.4;
                this.idleAngle = 2.4;
                this.bright = 0;
                this.lastT = performance.now();

                this.update = (now) => {
                    this.raf = requestAnimationFrame(this.update);
                    const dt = Math.min((now - this.lastT) / 1000, 0.05);
                    this.lastT = now;

                    this.idleAngle += props.speed * dt;
                    const steer = props.followMouse && this.pointerAngle !== null && (!props.autoAnimate || this.proximityT > 0);
                    const target = steer ? this.pointerAngle : this.idleAngle;
                    const diff = ((target - this.angle + Math.PI * 3) % (Math.PI * 2)) - Math.PI;
                    this.angle += diff * (1 - Math.exp(-dt * 7));

                    const brightTarget = props.autoAnimate ? 1 : this.proximityT;
                    this.bright += (brightTarget - this.bright) * (1 - Math.exp(-dt * 8));

                    this.program.uniforms.uAngle.value = this.angle;
                    this.program.uniforms.uIntensity.value = props.intensity * this.bright;

                    this.renderer.render({ scene: this.mesh });
                };
                this.raf = requestAnimationFrame(this.update);
            }
        }

        document.addEventListener('DOMContentLoaded', () => {
            const btnElement = document.getElementById('specular-btn');
            if (btnElement) {
                new SpecularButton(btnElement, {
                    radius: 40,
                    lineColor: '#FF87B2', 
                    baseColor: '#101C29', 
                    intensity: 1.5, 
                    shineSize: 10,
                    shineFade: 40,
                    thickness: 2,
                    speed: 0.35,
                    followMouse: true,
                    proximity: 250,
                    autoAnimate: false
                });
            }
        });
    </script>
    
    <script>
        let hasConsented = false;
        let selectedLoanType = null;
        let isUserLoggedIn = false; 

        function openLogin() {
            document.getElementById('view-home').classList.remove('active');
            document.getElementById('view-login').classList.add('active');
            window.scrollTo(0, 0);
        }

        function submitLogin() {
            isUserLoggedIn = true;
            document.getElementById('view-login').classList.remove('active');
            document.getElementById('centered-app-view').classList.add('active');
            document.body.classList.add('creme-bg');
            document.body.style.backgroundColor = ''; 
            
            if (!hasConsented) {
                document.getElementById('consent-modal').classList.add('active');
            }
            window.scrollTo(0, 0);
        }

        function validateForm() {
            const checkbox = document.getElementById('consent-checkbox');
            const btnAccept = document.getElementById('btn-accept');
            btnAccept.disabled = !checkbox.checked;
        }

        function acceptConsent() {
            hasConsented = true;
            document.getElementById('consent-modal').classList.remove('active');
        }

        function openFullScreenDoc(docId) {
            document.getElementById('view-home').classList.remove('active');
            document.getElementById('centered-app-view').classList.remove('active');
            
            if (document.getElementById('consent-modal').classList.contains('active')) {
                document.getElementById('consent-modal').classList.remove('active');
            }
            document.getElementById(docId).classList.add('active');
            window.scrollTo(0, 0); 
        }

        function closeFullScreenDoc() {
            document.getElementById('view-terms').classList.remove('active');
            document.getElementById('view-privacy').classList.remove('active');
            document.getElementById('view-policy').classList.remove('active');
            document.getElementById('view-cookies').classList.remove('active');

            if (isUserLoggedIn) {
                document.getElementById('centered-app-view').classList.add('active');
                if (!hasConsented) {
                    document.getElementById('consent-modal').classList.add('active');
                }
            } else {
                document.getElementById('view-home').classList.add('active');
            }
            window.scrollTo(0, 0);
        }

        function selectLoan(type, element) {
            selectedLoanType = type;
            const cards = document.querySelectorAll('.loan-card');
            cards.forEach(card => card.classList.remove('active'));
            element.classList.add('active');
            document.getElementById('btn-continue-details').disabled = false;
        }

        function goToDetails() {
            if (!selectedLoanType) return;
            document.getElementById('step-objective').style.display = 'none';
            document.getElementById('step-details').style.display = 'block';
        }

        function goBackToObjective() {
            document.getElementById('step-details').style.display = 'none';
            document.getElementById('step-objective').style.display = 'block';
        }

        function submitFinalDetails(event) {
            event.preventDefault(); 
            
            document.getElementById('step-details').style.display = 'none';
            
            const resultsArea = document.getElementById('results-area');
            const loadingText = document.getElementById('loading-text');
            
            resultsArea.style.display = 'block';
            loadingText.innerHTML = 'Connecting to AI Engine... <br><span style="font-size: 13px; color: var(--text-muted); font-weight: 600; margin-top: 6px; display: inline-block;">(Analyzing profile for ' + selectedLoanType.replace('_', ' ') + ' schemes)</span>';

            setTimeout(() => {
                loadingText.innerHTML = '✅ <strong style="font-size: 18px;" class="font-heading">Matches Found!</strong><br><br><span style="color: var(--text-main); font-size: 20px; font-weight: 800;" class="font-heading">Top Pick: Government Scheme Match</span>';
            }, 2500); 
        }

        document.addEventListener("DOMContentLoaded", () => {
            const accordionCards = document.querySelectorAll('.accordion-card');
            if (accordionCards.length > 0) {
                accordionCards.forEach(card => {
                    card.addEventListener('mouseenter', () => {
                        accordionCards.forEach(c => c.classList.remove('active'));
                        card.classList.add('active');
                    });
                });
            }
        });
    </script>
</body>
</html>
