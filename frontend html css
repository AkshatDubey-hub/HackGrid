    <script>
    let hasConsented = false;
    let selectedLoanType = null;
    let userDataStore = {}; // Holds data from Login Portal

    // Show Login Portal
    function openLogin() {
        document.getElementById('view-home').classList.remove('active');
        document.getElementById('view-login').classList.add('active');
        window.scrollTo(0, 0);
    }

    // Handle Login Save & API Post
    async function saveLoginAndNext(event) {
        event.preventDefault();
        
        // Collect user data
        userDataStore = {
            name: document.getElementById('login-name').value,
            age: document.getElementById('login-age').value,
            gender: document.getElementById('login-gender').value,
            caste: document.getElementById('login-caste').value,
            state: document.getElementById('login-state').value
        };

        // Attempt to send data to backend to store
        try {
            // Change URL to your real backend endpoint
            await fetch('http://127.0.0.1:8000/api/save-user', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(userDataStore)
            });
            console.log("User data saved to backend:", userDataStore);
        } catch (error) {
            console.warn("Backend not reachable. Proceeding with local state.", error);
        }

        // Transition to Dashboard
        document.getElementById('view-login').classList.remove('active');
        document.getElementById('centered-app-view').classList.add('active');
        document.body.classList.add('creme-bg');
        
        if (!hasConsented) {
            document.getElementById('consent-modal').classList.add('active');
        }
        window.scrollTo(0, 0);
    }

    // Modal Logic
    function validateForm() {
        document.getElementById('btn-accept').disabled = !document.getElementById('consent-checkbox').checked;
    }
    function acceptConsent() {
        hasConsented = true;
        document.getElementById('consent-modal').classList.remove('active');
    }

    // Dashboard Step Navigation
    function selectLoan(type, element) {
        selectedLoanType = type;
        document.querySelectorAll('.loan-card').forEach(c => c.classList.remove('active'));
        element.classList.add('active');
        document.getElementById('btn-continue-details').disabled = false;
    }
    function goToDetails() {
        document.getElementById('step-objective').style.display = 'none';
        document.getElementById('step-details').style.display = 'block';
    }
    function goBackToObjective() {
        document.getElementById('step-details').style.display = 'none';
        document.getElementById('step-objective').style.display = 'block';
    }

    // Checkbox initialization function
    function initCheckboxes() {
        const checkboxes = document.querySelectorAll('.doc-checkbox');
        
        checkboxes.forEach(checkbox => {
            // Load saved states from localStorage
            const savedState = localStorage.getItem(checkbox.id);
            if (savedState === 'true') {
                checkbox.checked = true;
            }

            // Listen for changes and save to localStorage
            checkbox.addEventListener('change', (e) => {
                localStorage.setItem(e.target.id, e.target.checked);
            });
        });
    }

    // Final Submission & Rendering Continuation Page
    async function submitFinalDetails(event) {
        event.preventDefault(); 
        
        // UI Transition to Loading State
        document.getElementById('step-details').style.display = 'none';
        document.getElementById('step-results').style.display = 'block';
        document.getElementById('loading-area').style.display = 'block';
        document.getElementById('results-content').style.display = 'none';
        
        // Widen the container for the report
        document.getElementById('main-container').classList.add('results-mode');

        // Combine Login data and Details data
        const requestPayload = {
            ...userDataStore,
            occupation: document.getElementById('occupation').value,
            annual_income: parseFloat(document.getElementById('annual-income').value),
            requested_amount: parseFloat(document.getElementById('req-amount').value),
            land_holding_acres: parseFloat(document.getElementById('land-holding').value) || 0,
            purpose: selectedLoanType
        };

        try {
            const response = await fetch('http://127.0.0.1:8000/api/match-loan', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(requestPayload)
            });

            let data;
            if (!response.ok) {
                throw new Error(`Server returned ${response.status}`);
            } else {
                data = await response.json();
            }

            renderContinuationPage(data);

        } catch (error) {
            console.error("API Error, rendering mock data instead.", error);
            // Mock data matching the new advanced prompt output for demonstration
            const mockData = {
                "primary_scheme": {
                    "name": "Prime Minister's Employment Generation Programme (PMEGP)",
                    "eligibility_verdict": `Because of your ${userDataStore.caste || 'category'} status and location, you qualify for maximum subvention under PMEGP.`,
                    "msme_benefits": "Up to 35% capital subsidy. Collateral-free up to ₹10 Lakhs via CGTMSE.",
                    "subsidy_details": "Margin money subsidy of 35% (Rural) or 25% (Urban).",
                    "interest_rate": "Standard bank lending rate (approx 9.5% - 11.5%).",
                    "application_workflow": ["Register on PMEGP e-Portal", "Submit Detailed Project Report (DPR)", "District Task Force Committee Interview", "Bank Appraisal and Sanction"]
                },
                "secondary_scheme": {
                    "name": "MUDRA Yojana (Tarun Category)",
                    "contingency": "If your project report is rejected due to high estimated project costs under PMEGP.",
                    "differences": "MUDRA does not offer capital subsidy but has a faster processing time and requires no margin money."
                },
                "document_checklist_and_generation": [
                    { "document": "Detailed Project Report (DPR)", "how_to_generate": "Use CA services or automated tools like ClearTax for 5-year financial projections and DSCR calculations." },
                    { "document": "Udyam Registration", "how_to_generate": "Self-generate for free on the official Udyam portal using your Aadhaar linked phone number." }
                ],
                "pitch_strategy": "Focus your bank interview on employment generation. Banks favor PMEGP applications that clearly show how the fund will hire local workers.",
                "fund_implementation": "Deploy 60% of funds strictly towards machinery (CAPEX) to satisfy subsidy rules, keeping 40% for working capital."
            };
            renderContinuationPage(mockData);
        }
    }

    function renderContinuationPage(data) {
        document.getElementById('loading-area').style.display = 'none';
        const content = document.getElementById('results-content');

        if (!data?.primary_scheme || !data?.secondary_scheme ||
            !Array.isArray(data.primary_scheme.application_workflow) ||
            !Array.isArray(data.document_checklist_and_generation)) {
            content.innerHTML = `
                <div class="report-section">
                    <span class="report-label">Unable to display results</span>
                    <p class="report-value">The backend returned an incomplete report. Please try again.</p>
                    <button class="btn mt-6" type="button" onclick="location.reload()">Try Again</button>
                </div>`;
            content.style.display = 'block';
            return;
        }
        
        // Build the Workflows list
        const workflowHTML = data.primary_scheme.application_workflow.map((step, index) => 
            `<div style="display: flex; gap: 12px; margin-bottom: 12px; align-items: flex-start;">
                <div style="background: var(--primary); color: white; width: 24px; height: 24px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: bold; flex-shrink: 0;">${index + 1}</div>
                <div style="font-size: 14px; color: var(--text-main); font-weight: 600; padding-top: 2px;">${step}</div>
            </div>`
        ).join('');

        // Build Documents list (UPDATED: Now generates the interactive Checkboxes)
        const docsHTML = data.document_checklist_and_generation.map((doc, index) => 
            `<label class="flex items-start gap-3 p-3 -ml-3 rounded-xl cursor-pointer hover:bg-[#F9FAFB] transition-colors" for="doc-${index}">
                <input type="checkbox" id="doc-${index}" class="doc-checkbox mt-1 w-4 h-4 accent-[#3D704D] rounded cursor-pointer">
                <div class="doc-content flex-1">
                    <h4 class="font-semibold text-[#0B120C] text-sm transition-colors">📄 ${doc.document}</h4>
                    <p class="text-[13px] text-[#5E7365] mt-1 leading-relaxed">💡 <em class="not-italic text-[#3D704D] font-medium">How to get it:</em> ${doc.how_to_generate}</p>
                </div>
            </label>`
        ).join('');

        content.innerHTML = `
            <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 24px;">
                <div>
                    <span class="report-label">AI Matchmaker Report</span>
                    <h2 class="font-heading" style="font-size: 28px; color: var(--primary);">Funding Strategy Ready</h2>
                </div>
                <button class="btn font-heading" style="width: auto; padding: 12px 24px; font-size: 14px;" onclick="window.print()">Save PDF</button>
            </div>

            <!-- PRIMARY SCHEME -->
            <div class="report-section" style="border-top: 4px solid var(--primary);">
                <span class="report-label">Primary Match (Highest Probability)</span>
                <h3 class="font-heading" style="font-size: 22px; margin-bottom: 12px;">${data.primary_scheme.name}</h3>
                
                <div style="background: #F0FDF4; padding: 16px; border-radius: 12px; margin-bottom: 20px;">
                    <span class="report-label">Eligibility Verdict</span>
                    <p class="report-value">${data.primary_scheme.eligibility_verdict}</p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
                    <div>
                        <span class="report-label">MSME Benefits & Subsidy</span>
                        <p class="report-value">${data.primary_scheme.msme_benefits} <br><span style="color: var(--text-muted); font-size: 13px;">${data.primary_scheme.subsidy_details}</span></p>
                    </div>
                    <div>
                        <span class="report-label">Interest Structure</span>
                        <p class="report-value">${data.primary_scheme.interest_rate}</p>
                    </div>
                </div>

                <span class="report-label">Application Workflow</span>
                <div style="margin-top: 12px;">${workflowHTML}</div>
            </div>

            <!-- SECONDARY / BACKUP SCHEME -->
            <div class="report-section" style="background: #FAFAFA;">
                <span class="report-label" style="color: #F59E0B;">Backup Scheme (Contingency)</span>
                <h3 class="font-heading" style="font-size: 18px; margin-bottom: 8px;">${data.secondary_scheme.name}</h3>
                <p class="report-value" style="font-size: 14px; margin-bottom: 8px;"><strong>When to pivot:</strong> ${data.secondary_scheme.contingency}</p>
                <p class="report-value" style="font-size: 14px; color: var(--text-muted);"><strong>Key Differences:</strong> ${data.secondary_scheme.differences}</p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                <!-- DOCUMENTS -->
                <div class="report-section mb-0">
                    <span class="report-label">Document Generation Guide</span>
                    <!-- The generated checkboxes will be injected here -->
                    <div class="doc-list mt-4 flex flex-col gap-1">${docsHTML}</div>
                </div>

                <!-- STRATEGY -->
                <div class="report-section mb-0" style="background: #111B13; color: white;">
                    <span class="report-label" style="color: #6EE7B7;">Pitch & Implementation Strategy</span>
                    
                    <div style="margin-top: 16px; margin-bottom: 20px;">
                        <strong style="font-size: 14px; color: white;">Bank Pitch Strategy:</strong>
                        <p style="font-size: 13px; color: #95A89A; margin-top: 6px; line-height: 1.5;">${data.pitch_strategy}</p>
                    </div>

                    <div>
                        <strong style="font-size: 14px; color: white;">Fund Deployment:</strong>
                        <p style="font-size: 13px; color: #95A89A; margin-top: 6px; line-height: 1.5;">${data.fund_implementation}</p>
                    </div>
                </div>
            </div>
            
            <button class="btn mt-6" style="background: #E8ECE9; color: var(--text-main); box-shadow: none;" onclick="location.reload()">Start New Application</button>
        `;
        content.style.display = 'block';

        // IMPORTANT: Initialize the checkboxes immediately after injecting the HTML
        initCheckboxes();
    }
</script>
</body>
</html>
