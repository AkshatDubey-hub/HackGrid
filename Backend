import json
import os
import time
from dotenv import load_dotenv
from fastapi import FastAPI, HTTPException
from fastapi.middleware.cors import CORSMiddleware
from pydantic import BaseModel, Field
from google import genai
from google.genai import types
import firebase_admin
from firebase_admin import credentials, firestore

# -------------------------------------------------------------
# 1. Initialize API & CORS
# -------------------------------------------------------------
app = FastAPI(title="Govt Loan Matcher - Hackathon API")

app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)

# -------------------------------------------------------------
# 2. Initialize Gemini API
# -------------------------------------------------------------
# Load environment variables from .env file
load_dotenv()  
GEMINI_KEY = os.environ.get("GEMINI_API_KEY")
client = genai.Client(api_key=GEMINI_KEY)

# -------------------------------------------------------------
# 3. Initialize Firebase & Firestore
# -------------------------------------------------------------
# Make sure 'serviceAccountKey.json' is in the same directory as this script.
db = None
try:
    cred = credentials.Certificate("firebase_credentials.json")
    firebase_admin.initialize_app(cred)
    db = firestore.client()
    print("Successfully connected to Firestore.")
except Exception as e:
    print(f"Error initializing Firebase: {e}")

# -------------------------------------------------------------
# 4. Input Data Model (What frontend sends)
# -------------------------------------------------------------
class ApplicantProfile(BaseModel):
    name: str = Field(..., example="Ramesh Kumar")
    age: int = Field(..., example=34)
    gender: str = Field(..., example="Male")
    caste_category: str = Field(..., example="SC")        # General, SC, ST, OBC
    occupation: str = Field(..., example="Farmer")        # Farmer, Artisan, Small Business, Student
    annual_income: float = Field(..., example=120000.0)
    requested_amount: float = Field(..., example=150000.0)
    land_holding_acres: float = Field(0.0, example=2.0)
    purpose: str = Field(..., example="Purchase seeds and drip irrigation")
    state: str = Field("Tamil Nadu", example="Tamil Nadu")

# -------------------------------------------------------------
# 5. Output Data Model (Structured JSON returned to frontend)
# -------------------------------------------------------------
class LoanRecommendation(BaseModel):
    applicant_name: str
    recommended_scheme: str
    administering_ministry: str
    subsidy_or_concession_details: str
    interest_rate_structure: str
    eligibility_verdict: str
    key_documents_required: list[str]
    alternative_options: list[str]

# -------------------------------------------------------------
# 6. Single-Prompt GenAI Route
# -------------------------------------------------------------
def fetch_schemes_from_firestore(collection_name: str = "schemes") -> list[dict]:
    """Retrieves all uploaded government scheme documents from Firestore."""
    try:
        docs = db.collection(collection_name).stream()
        schemes = []
        for doc in docs:
            scheme_data = doc.to_dict()
            scheme_data["id"] = doc.id
            schemes.append(scheme_data)
        return schemes
    except Exception as e:
        print(f"Firestore query failed: {e}")
        return []
@app.post("/api/match-loan", response_model=LoanRecommendation)
def match_loan(user: ApplicantProfile):
    # 1. Fetch live records from Firestore
    available_schemes = fetch_schemes_from_firestore(collection_name="schemes")

    if not available_schemes:
        raise HTTPException(
            status_code=500,
            detail="No schemes found in Firebase. Check collection name or documents."
        )

    # 2. Format database records for the prompt
    schemes_json_str = json.dumps(available_schemes, indent=2)

    prompt = f"""
    You are an expert advisor on Government of India and State financial schemes.
    Evaluate the applicant against ONLY the authorized schemes provided below from our official database.

    === APPLICANT PROFILE ===
    - Name: {user.name}
    - Age: {user.age}
    - Gender: {user.gender}
    - Caste / Category: {user.caste_category}
    - Occupation: {user.occupation}
    - Annual Income: INR {user.annual_income}
    - Requested Amount: INR {user.requested_amount}
    - Land Holding: {user.land_holding_acres} acres
    - State: {user.state}
    - Purpose: {user.purpose}

    === AVAILABLE SCHEMES DATABASE (PULLED FROM FIREBASE) ===
    {schemes_json_str}

    === INSTRUCTIONS ===
    1. Select the SINGLE BEST scheme from the provided Firebase list based on matching caste benefits, land criteria, occupation, and financial concessions.
    2. Populate `firebase_scheme_id` with the exact `id` from the database.
    3. Use the exact subsidy percentages and interest rate structures recorded in the scheme database.
    4. Provide a clear eligibility verdict explaining why this specific scheme maximizes benefits for this applicant.
    """

    # 3. Call Gemini with retry handling
    max_retries = 3
    for attempt in range(max_retries):
        try:
            response = client.models.generate_content(
                model="gemini-3.6-flash",
                contents=prompt,
                config=types.GenerateContentConfig(
                    response_mime_type="application/json",
                    response_schema=LoanRecommendation,
                    temperature=0.1,
                ),
            )
            return json.loads(response.text)

        except Exception as e:
            err_str = str(e)
            if "503" in err_str or "high demand" in err_str.lower():
                time.sleep(2)
                continue
            raise HTTPException(status_code=500, detail=f"Scheme matching failed: {err_str}")

    raise HTTPException(status_code=503, detail="Model temporarily unavailable after retries.")
