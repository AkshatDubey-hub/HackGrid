import json
import os
import time
from dotenv import load_dotenv
from fastapi import FastAPI, HTTPException
from fastapi.middleware.cors import CORSMiddleware
from pydantic import BaseModel, Field
from typing import List, Optional
from google import genai
from google.genai import types
import firebase_admin
from firebase_admin import credentials, firestore

# -------------------------------------------------------------
# 1. Initialize API & CORS
# -------------------------------------------------------------
app = FastAPI(title="FetchFunds API - Hackathon")

app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)

# -------------------------------------------------------------
# 2. Initialize Gemini API
# -------------------------------------------------------------
load_dotenv()  
GEMINI_KEY = os.environ.get("GEMINI_API_KEY")
client = genai.Client(api_key=GEMINI_KEY)

# -------------------------------------------------------------
# 3. Initialize Firebase & Firestore
# -------------------------------------------------------------
db = None
try:
    cred = credentials.Certificate("serviceAccountKey.json")
    firebase_admin.initialize_app(cred)
    db = firestore.client()
    print("Successfully connected to Firestore.")
except Exception as e:
    print(f"Error initializing Firebase: {e}")

# -------------------------------------------------------------
# 4. Input Data Models (Mapped to Frontend Payload)
# -------------------------------------------------------------
class UserLoginData(BaseModel):
    name: str = Field(...)
    age: int = Field(...)
    gender: str = Field(...)
    caste: str = Field(...)
    state: str = Field(...)

class FullApplicationData(UserLoginData):
    occupation: str = Field(...)
    annual_income: float = Field(...)
    requested_amount: float = Field(...)
    land_holding_acres: float = Field(0.0)
    purpose: str = Field(...)

# -------------------------------------------------------------
# 5. Output Data Models (Strict JSON schema for Gemini)
# -------------------------------------------------------------
class SchemeDetails(BaseModel):
    name: str
    firebase_scheme_id: str
    eligibility_verdict: str
    msme_benefits: str
    subsidy_details: str
    interest_rate: str
    application_workflow: List[str]
    contingency: Optional[str] = None
    differences: Optional[str] = None

class DocumentItem(BaseModel):
    document: str
    how_to_generate: str

class LoanRecommendation(BaseModel):
    primary_scheme: SchemeDetails
    secondary_scheme: SchemeDetails
    document_checklist_and_generation: List[DocumentItem]
    pitch_strategy: str
    fund_implementation: str

# -------------------------------------------------------------
# 6. Helper: Fetch Schemes from Database
# -------------------------------------------------------------
def fetch_schemes_from_firestore(collection_name: str = "schemes") -> list[dict]:
    """Retrieves all uploaded government scheme documents from Firestore."""
    if db is None:
        return []
    try:
        docs = db.collection(collection_name).stream()
        schemes = []
        for doc in docs:
            scheme_data = doc.to_dict()
            scheme_data["id"] = doc.id
            schemes.append(scheme_data)
        return schemes
    except Exception as e:
        print(f"Firestore query failed: {e}")
        return []

# -------------------------------------------------------------
# 7. Routes
# -------------------------------------------------------------
@app.post("/api/save-user")
def save_user(user_data: UserLoginData):
    """Saves the data from the initial login tab to Firestore."""
    if db is None:
        raise HTTPException(status_code=500, detail="Database not initialized")
    
    try:
        # Check if user already exists based on name/state combo to avoid duplicates (optional logic)
        doc_ref = db.collection("users").document()
        
        db_payload = user_data.model_dump()
        db_payload["created_at"] = firestore.SERVER_TIMESTAMP
        
        doc_ref.set(db_payload)
        
        return {
            "message": "User profile saved successfully", 
            "user_id": doc_ref.id
        }
    except Exception as e:
        raise HTTPException(status_code=500, detail=f"Failed to save user: {str(e)}")


@app.post("/api/match-loan", response_model=LoanRecommendation)
def match_loan(application_data: FullApplicationData):
    """Processes the full application, runs Gemini, and stores the final result."""
    if db is None:
        raise HTTPException(status_code=500, detail="Database not initialized")
    
    # 1. Fetch Schemes
    available_schemes = fetch_schemes_from_firestore(collection_name="schemes")
    if not available_schemes:
        raise HTTPException(status_code=500, detail="No schemes found in Firebase.")

    schemes_json_str = json.dumps(available_schemes, indent=2)

    # 2. Build Prompt 
    prompt = f"""
    You are an expert advisor on Government of India and State financial schemes.
    Evaluate the applicant against ONLY the authorized schemes provided below from our official database.

    === APPLICANT PROFILE ===
    - Name: {application_data.name}
    - Age: {application_data.age}
    - Gender: {application_data.gender}
    - Caste / Category: {application_data.caste}
    - Occupation: {application_data.occupation}
    - Annual Income: INR {application_data.annual_income}
    - Requested Amount: INR {application_data.requested_amount}
    - Land Holding: {application_data.land_holding_acres} acres
    - State: {application_data.state}
    - Purpose: {application_data.purpose}

    === AVAILABLE SCHEMES DATABASE (PULLED FROM FIREBASE) ===
    {schemes_json_str}

    === INSTRUCTIONS ===
    1. **Scheme Selection:** Select the BEST PRIMARY scheme and a viable SECONDARY (backup) scheme...
    2. **Financial Precision:** Use the exact subsidy percentages...
    3. **Eligibility Verdict & Contingency:** Provide a clear eligibility verdict...
    4. **MSME Benefits:** Outline the relevant points...
    5. **Application Workflow:** Provide a clear pathway...
    6. **Document Checklist & Generation:** List documents and provide generation guide...
    7. **Pitch & Proposal Strategy:** Outline key themes for the company to pitch...
    8. **Fund Implementation:** Provide actionable recommendations...
    """
    
    # 3. Call Gemini with Retry Logic
    max_retries = 3
    recommendation_data = None
    
    for attempt in range(max_retries):
        try:
            response = client.models.generate_content(
                model="gemini-3.6-flash", 
                contents=prompt,
                config=types.GenerateContentConfig(
                    response_mime_type="application/json",
                    response_schema=LoanRecommendation,
                    temperature=0.1,
                ),
            )
            recommendation_data = json.loads(response.text)
            break 
            
        except Exception as e:
            err_str = str(e)
            if "503" in err_str or "429" in err_str:
                time.sleep(2)
                continue
            raise HTTPException(status_code=500, detail=f"Scheme matching failed: {err_str}")

    if not recommendation_data:
        raise HTTPException(status_code=503, detail="Model temporarily unavailable.")

    # 4. Save the full application and AI result together in Firestore
    try:
        app_ref = db.collection("loan_applications").document()
        app_payload = {
            "user_profile": application_data.model_dump(),
            "ai_recommendation": recommendation_data,
            "status": "completed",
            "timestamp": firestore.SERVER_TIMESTAMP,
        }
        app_ref.set(app_payload)
    except Exception as db_err:
        print(f"Database Update Error: {db_err}")

    # 5. Return data to frontend
    return recommendation_data
