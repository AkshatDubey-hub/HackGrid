import json
import os
import time
from dotenv import load_dotenv
from fastapi import FastAPI, HTTPException
from fastapi.middleware.cors import CORSMiddleware
from pydantic import BaseModel, Field
from google import genai
from google.genai import types
import firebase_admin
from firebase_admin import credentials, firestore

# -------------------------------------------------------------
# 1. Initialize API & CORS
# -------------------------------------------------------------
app = FastAPI(title="Govt Loan Matcher - Hackathon API")

app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)

# -------------------------------------------------------------
# 2. Initialize Gemini API
# -------------------------------------------------------------
load_dotenv()  
GEMINI_KEY = os.environ.get("GEMINI_API_KEY")
client = genai.Client(api_key=GEMINI_KEY)

# -------------------------------------------------------------
# 3. Initialize Firebase & Firestore
# -------------------------------------------------------------
db = None
try:
    cred = credentials.Certificate("serviceAccountKey.json")
    firebase_admin.initialize_app(cred)
    db = firestore.client()
    print("Successfully connected to Firestore.")
except Exception as e:
    print(f"Error initializing Firebase: {e}")

# -------------------------------------------------------------
# 4. Input Data Models (Split into Two Steps)
# -------------------------------------------------------------
class ApplicantStep1(BaseModel):
    name: str = Field(...)
    age: int = Field(...)
    gender: str = Field(...)
    caste_category: str = Field(...)
    state: str = Field(...)

class ApplicantStep2(BaseModel):
    occupation: str = Field(...)
    annual_income: float = Field(...)
    requested_amount: float = Field(...)
    land_holding_acres: float = Field(0.0)
    purpose: str = Field(...)

# -------------------------------------------------------------
# 5. Output Data Model (Structured JSON returned to frontend)
# -------------------------------------------------------------
class LoanRecommendation(BaseModel):
    applicant_name: str
    recommended_scheme: str
    firebase_scheme_id: str  # Added this field based on your prompt instructions
    administering_ministry: str
    subsidy_or_concession_details: str
    interest_rate_structure: str
    eligibility_verdict: str
    key_documents_required: list[str]
    alternative_options: list[str]

# -------------------------------------------------------------
# 6. Helper: Fetch Schemes from Database
# -------------------------------------------------------------
def fetch_schemes_from_firestore(collection_name: str = "schemes") -> list[dict]:
    """Retrieves all uploaded government scheme documents from Firestore."""
    if db is None:
        return []
    try:
        docs = db.collection(collection_name).stream()
        schemes = []
        for doc in docs:
            scheme_data = doc.to_dict()
            scheme_data["id"] = doc.id
            schemes.append(scheme_data)
        return schemes
    except Exception as e:
        print(f"Firestore query failed: {e}")
        return []

# -------------------------------------------------------------
# 7. Routes
# -------------------------------------------------------------
@app.post("/api/application/step1")
def save_step1(user_initial: ApplicantStep1):
    if db is None:
        raise HTTPException(status_code=500, detail="Database not initialized")
    
    try:
        doc_ref = db.collection("loan_applications").document()
        doc_data = {
            "step1_data": user_initial.model_dump() if hasattr(user_initial, 'model_dump') else user_initial.dict(),
            "status": "draft",
            "timestamp": firestore.SERVER_TIMESTAMP
        }
        doc_ref.set(doc_data)
        
        return {
            "message": "Step 1 saved successfully", 
            "application_id": doc_ref.id
        }
    except Exception as e:
        raise HTTPException(status_code=500, detail=f"Failed to save step 1: {str(e)}")


@app.post("/api/match-loan/{application_id}", response_model=LoanRecommendation)
def match_loan(application_id: str, user_final: ApplicantStep2):
    if db is None:
        raise HTTPException(status_code=500, detail="Database not initialized")
    
    # 1. Fetch Step 1 data
    doc_ref = db.collection("loan_applications").document(application_id)
    doc_snap = doc_ref.get()
    if not doc_snap.exists:
        raise HTTPException(status_code=404, detail="Application ID not found. Complete step 1 first.")
    
    db_data = doc_snap.to_dict()
    step1_data = db_data.get("step1_data", {})

    # 2. Fetch Schemes
    available_schemes = fetch_schemes_from_firestore(collection_name="schemes")
    if not available_schemes:
        raise HTTPException(status_code=500, detail="No schemes found in Firebase. Ensure the 'schemes' collection is populated.")

    schemes_json_str = json.dumps(available_schemes, indent=2)

    # 3. Build Prompt (Fixed Variables)
    prompt = f"""
    You are an expert advisor on Government of India and State financial schemes.
    Evaluate the applicant against ONLY the authorized schemes provided below from our official database.

=== APPLICANT PROFILE ===
- Name: {step1_data.get('name')}
- Age: {step1_data.get('age')}
- Gender: {step1_data.get('gender')}
- Caste / Category: {step1_data.get('caste_category')}
- Occupation: {user_final.occupation}
- Annual Income: INR {user_final.annual_income}
- Requested Amount: INR {user_final.requested_amount}
- Land Holding: {user_final.land_holding_acres} acres
- State: {step1_data.get('state')}
- Purpose: {user_final.purpose}

=== AVAILABLE SCHEMES DATABASE (PULLED FROM FIREBASE) ===
{schemes_json_str}

=== INSTRUCTIONS ===
1. **Scheme Selection:** Select the BEST PRIMARY scheme and a viable SECONDARY (backup) scheme from the provided Firebase list based on matching caste benefits, land criteria, occupation, and financial concessions. Populate `primary_firebase_scheme_id` and `secondary_firebase_scheme_id` with the exact `id`s from the database.
2. **Financial Precision:** Use the exact subsidy percentages, margin money requirements, and interest rate structures recorded in the scheme database for both selected schemes.
3. **Eligibility Verdict & Contingency:** Provide a clear eligibility verdict explaining exactly why the primary scheme maximizes benefits. Then, define the specific scenarios or rejection reasons under which the applicant should pivot to the secondary scheme.
4. **MSME Benefits:** Outline the relevant points of the primary scheme that directly benefit the MSME (e.g., collateral-free guarantees, capital subsidies). Briefly note how the secondary scheme's benefits differ.
5. **Application Workflow:** Provide a clear, step-by-step pathway of the application process for the primary scheme. Highlight any major workflow differences if the applicant has to fall back to the secondary scheme.
6. **Document Checklist & Generation:** 
    *   List all mandatory documents necessary to apply for both schemes, clearly separating any documents unique to the backup scheme. 
    *   Provide a practical guide on how to generate or draft complex documents that aren't ready (e.g., using CA services or automated tools for Detailed Project Reports, 5-year financial projections, CMA data, Udyam Registration, and DSCR calculations).
7. **Pitch & Proposal Strategy:** Outline key themes for the company to pitch to maximize approval chances (e.g., highlighting employment generation, rural development). If the backup scheme has a different focus (e.g., technology upgrade vs. employment), specify how the pitch must change.
8. **Fund Implementation:** Provide actionable recommendations on how to effectively deploy the secured fund amount to ensure business growth, regulatory compliance, and seamless loan repayment.
    """
    
    # 4. Call Gemini with Retry Logic
    max_retries = 3
    recommendation_data = None
    
    for attempt in range(max_retries):
        try:
            response = client.models.generate_content(
                model="gemini-3.6-flash", # Updated to current stable version
                contents=prompt,
                config=types.GenerateContentConfig(
                    response_mime_type="application/json",
                    response_schema=LoanRecommendation,
                    temperature=0.1,
                ),
            )
            recommendation_data = json.loads(response.text)
            break # Success, exit retry loop
            
        except Exception as e:
            err_str = str(e)
            if "503" in err_str or "high demand" in err_str.lower() or "429" in err_str:
                time.sleep(2)
                continue
            raise HTTPException(status_code=500, detail=f"Scheme matching failed: {err_str}")

    if not recommendation_data:
        raise HTTPException(status_code=503, detail="Model temporarily unavailable after retries.")

    # 5. Update Firestore with Final Data
    try:
        step2_dict = user_final.model_dump() if hasattr(user_final, 'model_dump') else user_final.dict()
        doc_ref.update({
            "step2_data": step2_dict,
            "recommendation": recommendation_data,
            "status": "completed",
            "completed_timestamp": firestore.SERVER_TIMESTAMP,
        })
    except Exception as db_err:
        print(f"Database Update Error: {db_err}")

    return recommendation_data
