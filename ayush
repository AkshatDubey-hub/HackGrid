<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Fetch Funds - Small Business Portal</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Syne:wght@700;800;900&display=swap" rel="stylesheet">

  <style>
    body {
      font-family: 'Plus Jakarta Sans', sans-serif;
    }

    .font-syne {
      font-family: 'Syne', sans-serif;
    }

    /* Ambient dark diagonal stripe background matching deep green elements */
    .bg-dark-pattern {
      background-color: #0B120C;
      background-image: repeating-linear-gradient(
        -45deg,
        #0B120C,
        #0B120C 20px,
        #111B13 20px,
        #111B13 40px
      );
    }
  </style>
</head>
<body class="bg-dark-pattern min-h-screen w-screen flex items-center justify-center p-4 sm:p-6 lg:p-10 antialiased text-[#E2E8F0]">

  <!-- MAIN CARD CONTAINER -->
  <div class="w-full max-w-6xl bg-[#141F16] rounded-[32px] shadow-[0_25px_70px_rgba(0,0,0,0.8)] overflow-hidden flex flex-col md:flex-row min-h-[640px] border border-[#273B2B]">

    <!-- LEFT PANEL: LOGO & FORM FIELDS -->
    <div class="w-full md:w-[58%] xl:w-[55%] p-6 sm:p-10 flex flex-col justify-between relative bg-[#141F16]">
      
      <!-- TOP HEADER / LOGO AT TOP LEFT CORNER -->
      <header class="flex items-center justify-between w-full mb-6">
        <div class="flex items-center gap-3 group cursor-pointer">
          <svg class="w-10 h-10 drop-shadow-md transition-transform group-hover:scale-105" viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <clipPath id="circleViewNavDark">
                <circle cx="100" cy="100" r="65" />
              </clipPath>
            </defs>
            <g clip-path="url(#circleViewNavDark)">
              <circle cx="100" cy="100" r="65" fill="#FFFFFF" />
              <path d="M 25 100 A 65 65 0 0 1 175 100 Z" fill="#3D704D" />
              <rect x="71" y="102" width="14" height="65" fill="#141F16" rx="1" />
              <rect x="93" y="88" width="14" height="80" fill="#141F16" rx="1" />
              <rect x="115" y="72" width="14" height="95" fill="#141F16" rx="1" />
            </g>
            <path d="M 32 114 C 65 114, 115 94, 144 60 C 124 86, 75 110, 32 114 Z" fill="#6EE7B7" />
            <path d="M 30 114 Q 95 106 145 58 C 137 74, 103 108 30 114 Z" fill="#34D399" />
          </svg>
          <span class="font-syne font-extrabold text-xl text-white tracking-tight">Fetch Funds</span>
        </div>
      </header>

      <!-- FORM SECTION -->
      <div class="my-auto max-w-md w-full mx-auto md:mx-0">
        <h2 class="text-3xl sm:text-4xl font-extrabold text-white mb-1 tracking-tight">
          Get Started
        </h2>
        <p class="text-xs sm:text-sm text-[#95A89A] mb-5 font-medium">
          Enter your unique account details below to unlock personalized funding options.
        </p>

        <form onsubmit="event.preventDefault();" class="space-y-3.5">
          
          <!-- 1. USERNAME FIELD -->
          <div>
            <label class="block text-[11px] font-extrabold uppercase tracking-wider text-[#8DA092] mb-1">
              USERNAME:
            </label>
            <input 
              type="text" 
              placeholder="e.g. rahul_sharma99"
              class="w-full bg-[#1F2E22] text-white placeholder-[#5E7365] text-sm font-semibold rounded-xl px-4 py-2.5 border border-[#2D4232] focus:outline-none focus:ring-2 focus:ring-[#3D704D] focus:bg-[#25382A] transition"
            />
          </div>

          <!-- 2. PASSWORD FIELD -->
          <div>
            <label class="block text-[11px] font-extrabold uppercase tracking-wider text-[#8DA092] mb-1">
              PASSWORD:
            </label>
            <input 
              type="password" 
              placeholder="••••••••"
              class="w-full bg-[#1F2E22] text-white placeholder-[#5E7365] text-sm font-semibold rounded-xl px-4 py-2.5 border border-[#2D4232] focus:outline-none focus:ring-2 focus:ring-[#3D704D] focus:bg-[#25382A] transition"
            />
          </div>

          <!-- 3. AGE & REGION ROW -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <!-- AGE -->
            <div>
              <label class="block text-[11px] font-extrabold uppercase tracking-wider text-[#8DA092] mb-1">
                AGE:
              </label>
              <input 
                type="number" 
                placeholder="e.g. 32"
                class="w-full bg-[#1F2E22] text-white placeholder-[#5E7365] text-sm font-semibold rounded-xl px-4 py-2.5 border border-[#2D4232] focus:outline-none focus:ring-2 focus:ring-[#3D704D] focus:bg-[#25382A] transition"
              />
            </div>

            <!-- REGION (INDIAN STATES & UNION TERRITORIES) -->
            <div>
              <label class="block text-[11px] font-extrabold uppercase tracking-wider text-[#8DA092] mb-1">
                REGION:
              </label>
              <select class="w-full bg-[#1F2E22] text-white text-sm font-semibold rounded-xl px-4 py-2.5 border border-[#2D4232] focus:outline-none focus:ring-2 focus:ring-[#3D704D] focus:bg-[#25382A] transition appearance-none cursor-pointer">
                <option value="" disabled selected class="bg-[#1F2E22] text-white">Select State / UT</option>
                <optgroup label="States" class="bg-[#1F2E22] text-[#6EE7B7]">
                  <option value="Andhra Pradesh" class="bg-[#1F2E22] text-white">Andhra Pradesh</option>
                  <option value="Arunachal Pradesh" class="bg-[#1F2E22] text-white">Arunachal Pradesh</option>
                  <option value="Assam" class="bg-[#1F2E22] text-white">Assam</option>
                  <option value="Bihar" class="bg-[#1F2E22] text-white">Bihar</option>
                  <option value="Chhattisgarh" class="bg-[#1F2E22] text-white">Chhattisgarh</option>
                  <option value="Goa" class="bg-[#1F2E22] text-white">Goa</option>
                  <option value="Gujarat" class="bg-[#1F2E22] text-white">Gujarat</option>
                  <option value="Haryana" class="bg-[#1F2E22] text-white">Haryana</option>
                  <option value="Himachal Pradesh" class="bg-[#1F2E22] text-white">Himachal Pradesh</option>
                  <option value="Jharkhand" class="bg-[#1F2E22] text-white">Jharkhand</option>
                  <option value="Karnataka" class="bg-[#1F2E22] text-white">Karnataka</option>
                  <option value="Kerala" class="bg-[#1F2E22] text-white">Kerala</option>
                  <option value="Madhya Pradesh" class="bg-[#1F2E22] text-white">Madhya Pradesh</option>
                  <option value="Maharashtra" class="bg-[#1F2E22] text-white">Maharashtra</option>
                  <option value="Manipur" class="bg-[#1F2E22] text-white">Manipur</option>
                  <option value="Meghalaya" class="bg-[#1F2E22] text-white">Meghalaya</option>
                  <option value="Mizoram" class="bg-[#1F2E22] text-white">Mizoram</option>
                  <option value="Nagaland" class="bg-[#1F2E22] text-white">Nagaland</option>
                  <option value="Odisha" class="bg-[#1F2E22] text-white">Odisha</option>
                  <option value="Punjab" class="bg-[#1F2E22] text-white">Punjab</option>
                  <option value="Rajasthan" class="bg-[#1F2E22] text-white">Rajasthan</option>
                  <option value="Sikkim" class="bg-[#1F2E22] text-white">Sikkim</option>
                  <option value="Tamil Nadu" class="bg-[#1F2E22] text-white">Tamil Nadu</option>
                  <option value="Telangana" class="bg-[#1F2E22] text-white">Telangana</option>
                  <option value="Tripura" class="bg-[#1F2E22] text-white">Tripura</option>
                  <option value="Uttar Pradesh" class="bg-[#1F2E22] text-white">Uttar Pradesh</option>
                  <option value="Uttarakhand" class="bg-[#1F2E22] text-white">Uttarakhand</option>
                  <option value="West Bengal" class="bg-[#1F2E22] text-white">West Bengal</option>
                </optgroup>
                <optgroup label="Union Territories" class="bg-[#1F2E22] text-[#6EE7B7]">
                  <option value="Andaman and Nicobar Islands" class="bg-[#1F2E22] text-white">Andaman &amp; Nicobar Islands</option>
                  <option value="Chandigarh" class="bg-[#1F2E22] text-white">Chandigarh</option>
                  <option value="Dadra and Nagar Haveli and Daman and Diu" class="bg-[#1F2E22] text-white">Dadra &amp; Nagar Haveli and Daman &amp; Diu</option>
                  <option value="Delhi" class="bg-[#1F2E22] text-white">Delhi (NCT)</option>
                  <option value="Jammu and Kashmir" class="bg-[#1F2E22] text-white">Jammu &amp; Kashmir</option>
                  <option value="Ladakh" class="bg-[#1F2E22] text-white">Ladakh</option>
                  <option value="Lakshadweep" class="bg-[#1F2E22] text-white">Lakshadweep</option>
                  <option value="Puducherry" class="bg-[#1F2E22] text-white">Puducherry</option>
                </optgroup>
              </select>
            </div>
          </div>

          <!-- 4. SPECIAL CATEGORY -->
          <div>
            <label class="block text-[11px] font-extrabold uppercase tracking-wider text-[#8DA092] mb-1">
              SPECIAL CATEGORY:
            </label>
            <select class="w-full bg-[#1F2E22] text-white text-sm font-semibold rounded-xl px-4 py-2.5 border border-[#2D4232] focus:outline-none focus:ring-2 focus:ring-[#3D704D] focus:bg-[#25382A] transition appearance-none cursor-pointer">
              <option value="" disabled selected class="bg-[#1F2E22] text-white">Select Special Category</option>
              <option value="women" class="bg-[#1F2E22] text-white">Women Entrepreneur</option>
              <option value="sc" class="bg-[#1F2E22] text-white">SC (Scheduled Castes)</option>
              <option value="st" class="bg-[#1F2E22] text-white">ST (Scheduled Tribes)</option>
              <option value="obc" class="bg-[#1F2E22] text-white">OBC (Other Backward Classes)</option>
              <option value="pwd" class="bg-[#1F2E22] text-white">Differently Abled (PwD)</option>
              <option value="general" class="bg-[#1F2E22] text-white">General / Other</option>
            </select>
          </div>

          <!-- SUBMIT / ACTION BUTTON -->
          <button class="w-full mt-3 bg-[#3D704D] hover:bg-[#49855C] text-white font-extrabold text-sm py-3.5 px-5 rounded-xl transition-all duration-300 shadow-lg shadow-[#3D704D]/20 flex items-center justify-center gap-2 group">
            <span>Fetch Funds Now</span>
            <svg class="w-4 h-4 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
            </svg>
          </button>

        </form>
      </div>

      <!-- FOOTER TEXT -->
      <div class="mt-5 text-[11px] text-[#697E6E] font-medium">
        Empowering Small Business • Access Funds • Grow Your Future
      </div>

    </div>

    <!-- RIGHT PANEL: DARK GRAPHIC PATTERN PANEL -->
    <div class="w-full md:w-[42%] xl:w-[45%] bg-[#0D150E] relative overflow-hidden flex flex-col items-center justify-center p-8 sm:p-12 text-white border-t md:border-t-0 md:border-l border-[#273B2B]">
      
      <!-- ABSTRACT LAYERED DIAGONAL PILL GRAPHICS -->
      <div class="absolute inset-0 overflow-hidden pointer-events-none">
        <!-- Pill 1 -->
        <div class="absolute -top-10 -right-10 w-48 h-[480px] bg-[#162419] rounded-full transform rotate-[35deg] opacity-80 shadow-2xl"></div>
        <!-- Pill 2 -->
        <div class="absolute top-20 -right-20 w-52 h-[550px] bg-[#223626] rounded-full transform rotate-[35deg] opacity-90 shadow-2xl"></div>
        <!-- Pill 3 -->
        <div class="absolute -bottom-20 right-10 w-56 h-[500px] bg-[#314E38] rounded-full transform rotate-[35deg] opacity-80 shadow-2xl"></div>
        <!-- Pill 4 -->
        <div class="absolute -bottom-32 -left-10 w-40 h-[400px] bg-[#0A100B] rounded-full transform rotate-[35deg] opacity-70"></div>
      </div>

      <!-- OVERLAY CONTENT ON RIGHT PANEL -->
      <div class="relative z-10 text-center max-w-xs space-y-4">
        
        <!-- CUTOUT SVG LOGO IN GLOWING BADGE -->
        <div class="w-24 h-24 mx-auto bg-white/10 backdrop-blur-md rounded-3xl p-3 border border-white/15 shadow-2xl flex items-center justify-center">
          <svg class="w-full h-full drop-shadow-md" viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <clipPath id="circleViewRightDark">
                <circle cx="100" cy="100" r="65" />
              </clipPath>
            </defs>
            <g clip-path="url(#circleViewRightDark)">
              <circle cx="100" cy="100" r="65" fill="#FFFFFF" />
              <path d="M 25 100 A 65 65 0 0 1 175 100 Z" fill="#3D704D" />
              <rect x="71" y="102" width="14" height="65" fill="#141F16" rx="1" />
              <rect x="93" y="88" width="14" height="80" fill="#141F16" rx="1" />
              <rect x="115" y="72" width="14" height="95" fill="#141F16" rx="1" />
            </g>
            <path d="M 32 114 C 65 114, 115 94, 144 60 C 124 86, 75 110, 32 114 Z" fill="#6EE7B7" />
            <path d="M 30 114 Q 95 106 145 58 C 137 74, 103 108 30 114 Z" fill="#34D399" />
          </svg>
        </div>

        <h3 class="font-syne font-extrabold text-2xl sm:text-3xl text-white tracking-tight leading-tight">
          FETCH FUNDS
        </h3>

        <p class="text-xs sm:text-sm text-emerald-100/70 font-medium leading-relaxed">
          Empowering Small Business.<br>
          Access Funds.<br>
          Grow Your Future.
        </p>

        <div class="pt-4">
          <span class="inline-block bg-white/10 backdrop-blur-md border border-white/15 text-white font-bold text-[10px] tracking-widest uppercase px-4 py-1.5 rounded-full shadow-inner">
            Fast • Secure • Direct
          </span>
        </div>

      </div>

    </div>

  </div>

</body>
</html>
